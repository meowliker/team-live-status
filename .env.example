# Copy this file to .env and fill in the values. Never share these keys in chat.

# ── Jibble ── Settings → Integrations → API Credentials → create new secret
#    (create it from an Owner/Admin account so everyone is visible)
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=

# ── ClickUp ── Avatar → Settings → Apps → API Token (starts with pk_)
#    Must be a Workspace Owner/Admin token to see everyone's timers.
CLICKUP_TOKEN=
# The number in your ClickUp URL: app.clickup.com/<THIS NUMBER>/...
CLICKUP_TEAM_ID=

# ── Protect the link (strongly recommended once it is online) ──
DASHBOARD_USER=team
DASHBOARD_PASSWORD=

# ── Optional settings ──
TIMEZONE=Asia/Kolkata
POLL_SECONDS=60
# Blank / frozen screenshot checks (needs screenshots on in Jibble). off = disable
SCREENSHOT_CHECKS=on
AWAY_MINUTES=20
NO_SCREENSHOT_MINUTES=30
FROZEN_MINUTES=30
BREAK_ALLOWANCE_MINUTES=90
LONG_BREAK_MINUTES=45
WORK_TARGET_MINUTES=420
POOL_IDLE_ALERT_MINUTES=15
# off (default) = people join the pool only when someone adds them; on = automatically when clocked in with no ClickUp timer
AUTO_POOL=off
# A running ClickUp timer on a task whose name starts with this word puts the person in the pool (empty = off)
POOL_TASK_WORD=pool

# ── Slack (optional) ── messages for "Needs attention" and pool posts. Off until a token is set.
# Bot token from api.slack.com/apps → your app → OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=
# Channel for "someone is free in the pool" posts (invite the bot there). Empty = off
SLACK_POOL_CHANNEL=#creatives
# Minutes before the reminder (and the message to the managers in team.config.ts)
SLACK_REMIND_MINUTES=10
# on = log messages instead of sending them (always on in demo mode)
SLACK_DRY_RUN=off
# Where picks / free-busy choices are saved
DATA_DIR=.data
